{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aicore-chat",
  "version": "0.1.0",
  "identifier": "dev.aicore.chat-example",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "aicore chat", "width": 900, "height": 720, "minWidth": 420, "minHeight": 400 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": { "models/": "models/" }
  }
}
